{
  "name": "ps-neighborhood",
  "productName": "PS Neighborhood",
  "version": "0.10.1",
  "private": true,
  "type": "module",
  "main": "desktop/entry.cjs",
  "description": "PS4 and PS5 desktop memory workbench with MCP, Ghidra exports, FTP and payload loading; platform-specific package and console management",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=24"
  },
  "keywords": [
    "ps4",
    "ps4debug",
    "goldhen",
    "homebrew",
    "mcp",
    "memory-scanner",
    "ghidra",
    "pkg-installer",
    "electron",
    "ps5",
    "ps5debug"
  ],
  "scripts": {
    "start": "electron .",
    "serve": "node src/server.mjs",
    "mcp": "node src/mcp.mjs",
    "trainer": "electron desktop/trainer.cjs",
    "build:receiver": "node receiver/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.1.0",
    "basic-ftp": "6.2.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.1.0",
    "electron": "44.4.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/GronedWaffel/ps-neighborhood.git"
  },
  "homepage": "https://github.com/GronedWaffel/ps-neighborhood#readme",
  "bugs": {
    "url": "https://github.com/GronedWaffel/ps-neighborhood/issues"
  }
}
